# Copy to .env and fill in. Never commit .env.

# Required only for chat (POST /api/chat) and evals (wra eval).
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=low
# DATA_DIR=data/live
# TRUSTED_IP_HEADER=X-Real-IP          # only behind a proxy that sets it (Railway)

# Risk-change alerts (spec 002)
# ALERT_INTERVAL_HOURS=0               # 0 = scheduler off; Railway uses 24
# ALERT_THRESHOLD=2.0                  # score points on the 0-100 scale
# ALERT_WEBHOOK_URL=                   # e.g. a webhook.site or Slack incoming-webhook URL
# ALERT_ADMIN_TOKEN=                   # protects POST /api/alerts/check and /demo
